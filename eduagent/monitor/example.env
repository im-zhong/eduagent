# EduAgent 监控系统环境变量配置示例
# 复制此文件到项目根目录并重命名为 .env

# ============================================
# Grafana 配置
# ============================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123  # 建议修改为强密码

# ============================================
# Prometheus 配置
# ============================================
PROMETHEUS_PORT=9090

# ============================================
# cAdvisor 配置
# ============================================
CADVISOR_PORT=8080

# ============================================
# 其他监控配置（可选）
# ============================================
# 如果添加了 PostgreSQL Exporter
# POSTGRES_EXPORTER_PORT=9187

# 如果添加了 Node Exporter
# NODE_EXPORTER_PORT=9100



