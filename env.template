# EduAgent 环境变量配置模板
# 
# 使用方法：
# Windows PowerShell: Copy-Item env.template .env
# Linux/Mac: cp env.template .env

# ==================== 用户配置 ====================
# Linux/Mac: 自动获取 $(id -u) 和 $USER
# Windows: 使用固定值或 %USERNAME%
USER=eduagent
UID=1000

# ==================== 数据库配置 ====================
POSTGRES_USER=ysu_keg
POSTGRES_PASSWORD=123456789
POSTGRES_DB=eduagent

# ==================== 应用端口配置 ====================
# API 端口
EDUAGENT_API_PORT=8000

# UI 端口
EDUAGENT_UI_PORT=8501

# ==================== 监控系统端口配置 ====================
# Prometheus 端口
PROMETHEUS_PORT=9090

# Grafana 端口
GRAFANA_PORT=3000

# cAdvisor 端口
CADVISOR_PORT=8081

# ==================== Grafana 配置 ====================
# Grafana 管理员账户
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin


